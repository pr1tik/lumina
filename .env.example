# Shopify Storefront Configuration
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store-domain.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# Site URL for SEO and Sitemap generation
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# Revalidation Secret for Webhooks (Optional but recommended)
SHOPIFY_REVALIDATION_SECRET=your-secret-here
